# Server Configuration
PORT=3000
NODE_ENV=development
TZ=America/Santiago
SITE_URL=http://localhost:3000

# Database Configuration
# Desarrollo usa SQLite por defecto (./database.sqlite).
# Producción usa MySQL via DATABASE_URL o variables DB_* individuales:
# DATABASE_URL=mysql://usuario:password@localhost:3306/cabana_pinohuacho
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cabana_pinohuacho
DB_USER=root
DB_PASS=
DB_SSL=false

# Session Configuration (OBLIGATORIO cambiar en producción)
SESSION_SECRET=cambia-esta-clave-por-una-cadena-larga-y-aleatoria

# Email Configuration (Nodemailer - Gmail App Password o SMTP)
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=tu-app-password
ADMIN_NOTIFY_EMAIL=admin@pinohuacho.cl

# Cabin Business Settings
DEFAULT_NIGHT_PRICE=50000
CABIN_EMAIL=info@pinohuacho.cl
CABIN_PHONE=+56 9 1234 5678
CABIN_WHATSAPP=56912345678
CABIN_MAPS_URL=https://www.google.com/maps/search/?api=1&query=Pino+Huacho+Araucania+Chile
CABIN_FACEBOOK_URL=
CABIN_INSTAGRAM_URL=

# Admin User (para seeder inicial - CAMBIAR en producción)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pinohuacho.cl
ADMIN_PASSWORD=cambia-esta-clave-admin
