<% extraStyles = '<link rel="stylesheet" href="/css/index.css">' %>
<% extraScripts = '<script src="/js/index.js"></script>' %>

<!-- Hero Section -->
<section class="hero-section">
  <picture class="hero-bg-picture" aria-hidden="true">
    <source srcset="/img/portada.webp" type="image/webp">
    <img
      class="hero-bg-img"
      src="/img/portada.jpg"
      alt=""
      width="1600"
      height="1067"
      fetchpriority="high"
      decoding="async"
    >
  </picture>
  <div class="hero-overlay"></div>
  <div class="container h-100">
    <div class="row h-100 align-items-center">
      <div class="col-lg-8">
        <div class="hero-content text-white">
          <h1 class="display-4 fw-bold mb-4">
            🌲 <%= cabin.tagline %>
          </h1>
          <p class="lead mb-4">Escapa de la rutina y conecta con la naturaleza en nuestra acogedora cabaña ubicada en Pino Huacho. Un refugio perfecto para hasta <%= cabin.maxGuests %> personas rodeado de bosques nativos y lagos cristalinos.</p>
          <div class="hero-buttons">
            <a class="btn btn-warning btn-lg me-3" href="/reservar">
              📅 Reservar Ahora
            </a>
            <a class="btn btn-outline-light btn-lg" href="/caracteristicas">
              🏠 Ver Características
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Quick Info Section -->
<section class="py-5 bg-light">
  <div class="container">
    <div class="row text-center g-4">
      <div class="col-md-3">
        <div class="feature-card p-4 h-100">
          <div class="feature-icon mb-3" aria-hidden="true">👥</div>
          <h5 class="fw-bold">Hasta <%= cabin.maxGuests %> personas</h5>
          <p class="text-muted">Espaciosa y cómoda para grupos familiares y amigos</p>
        </div>
      </div>

      <div class="col-md-3">
        <div class="feature-card p-4 h-100">
          <div class="feature-icon mb-3" aria-hidden="true">🛏️</div>
          <h5 class="fw-bold"><%= cabin.bedrooms %> Habitaciones</h5>
          <p class="text-muted">Dormitorios acogedores con ropa de cama incluida</p>
        </div>
      </div>

      <div class="col-md-3">
        <div class="feature-card p-4 h-100">
          <div class="feature-icon mb-3" aria-hidden="true">🔥</div>
          <h5 class="fw-bold">Calefacción a leña</h5>
          <p class="text-muted">Ambiente cálido y acogedor durante todo el año</p>
        </div>
      </div>

      <div class="col-md-3">
        <div class="feature-card p-4 h-100">
          <div class="feature-icon mb-3" aria-hidden="true">🌲</div>
          <h5 class="fw-bold">Entorno natural</h5>
          <p class="text-muted">Rodeada de bosques nativos y senderos para explorar</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Availability Calendar Section -->
<section class="py-5" id="disponibilidad">
  <div class="container">
    <div class="row">
      <div class="col-12 text-center mb-5">
        <h2 class="display-5 fw-bold">📅 Disponibilidad y Tarifas en Tiempo Real</h2>
        <p class="lead">Selecciona tu fecha de entrada y salida (incluso entre meses distintos) para cotizar tu estadía</p>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="card shadow-lg border-0">
          <div class="card-header text-white text-center py-4">
            <div class="d-flex justify-content-between align-items-center">
              <button type="button" class="btn btn-outline-light" id="prev-month-btn" aria-label="Mes anterior">← Anterior</button>
              <h4 class="mb-0" id="calendar-title">📅 Cargando...</h4>
              <button type="button" class="btn btn-outline-light" id="next-month-btn" aria-label="Mes siguiente">Siguiente →</button>
            </div>
          </div>

          <div class="card-body p-4">
            <!-- Calendar Legend -->
            <div class="row mb-4">
              <div class="col-12">
                <div class="d-flex justify-content-center flex-wrap gap-4">
                  <div class="legend-item d-flex align-items-center">
                    <div class="legend-color available me-2"></div>
                    <span>Disponible</span>
                  </div>
                  <div class="legend-item d-flex align-items-center">
                    <div class="legend-color occupied me-2"></div>
                    <span>Ocupado</span>
                  </div>
                  <div class="legend-item d-flex align-items-center">
                    <div class="legend-color maintenance me-2"></div>
                    <span>Mantenimiento</span>
                  </div>
                  <div class="legend-item d-flex align-items-center">
                    <div class="legend-color selected me-2"></div>
                    <span>Seleccionado</span>
                  </div>
                </div>
              </div>
            </div>

            <div id="calendar-selection-hint" class="text-center text-muted small mb-3">
              Haz clic en un día disponible para elegir tu fecha de entrada y luego en otro día para tu fecha de salida.
            </div>

            <!-- Calendar Container -->
            <div id="availability-calendar" class="calendar-grid" data-today="<%= currentDate %>">
              <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                  <span class="visually-hidden">Cargando calendario...</span>
                </div>
              </div>
            </div>

            <!-- Selected Dates Info -->
            <div id="selected-dates-info" class="mt-4 d-none">
              <div class="alert alert-info d-block">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <h6 class="fw-bold mb-0">📋 Fechas Seleccionadas</h6>
                  <button type="button" class="btn btn-sm btn-outline-secondary" id="clear-selection-btn">Limpiar</button>
                </div>
                <div class="row g-2">
                  <div class="col-md-4">
                    <strong>📅 Entrada: </strong>
                    <span id="selected-checkin">-</span>
                  </div>
                  <div class="col-md-4">
                    <strong>📅 Salida: </strong>
                    <span id="selected-checkout">-</span>
                  </div>
                  <div class="col-md-4">
                    <strong>🌙 Noches: </strong>
                    <span id="selected-nights">-</span>
                  </div>
                </div>
                <div class="mt-3">
                  <strong>💰 Total estimado: </strong>
                  <span id="estimated-price">$0 CLP</span>
                </div>
                <div class="mt-3 text-center">
                  <a class="btn btn-success btn-lg" href="/reservar" id="reserve-btn">
                    ✅ Solicitar Reserva para estas fechas
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Gallery Preview Section -->
<section class="py-5 bg-light">
  <div class="container">
    <div class="row">
      <div class="col-12 text-center mb-5">
        <h2 class="display-5 fw-bold">🏞️ Un Lugar Único para Descansar</h2>
        <p class="lead">Descubre la belleza natural de la Araucanía desde nuestra cabaña</p>
      </div>
    </div>

    <div class="row g-4">
      <% cabin.gallery.slice(0, 4).forEach(function(item) { %>
      <div class="col-md-6">
        <div class="gallery-item position-relative overflow-hidden rounded-3">
          <picture>
            <source srcset="<%= item.src %>" type="image/webp">
            <img class="img-fluid gallery-img" src="<%= item.fallback %>" alt="<%= item.alt %>" width="1200" height="800" loading="lazy" decoding="async">
          </picture>
          <div class="gallery-overlay">
            <h5><%= item.title %></h5>
            <p class="mb-0"><%= item.description %></p>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Map Section -->
<section class="py-5 bg-white">
  <div class="container">
    <div class="row">
      <div class="col-12 text-center mb-5">
        <h2 class="display-6 fw-bold">📍 ¿Dónde estamos?</h2>
        <p class="lead">Encuentra nuestra cabaña en el corazón de la Araucanía, cerca de Lican Ray y Coñaripe</p>
      </div>
    </div>
    <div class="row justify-content-center">
      <div class="col-lg-10 text-center">
        <picture>
          <source srcset="/img/mapa.webp" type="image/webp">
          <img class="img-fluid rounded-3 shadow mb-4" src="/img/mapa.png" alt="Ubicación de Cabaña Pino Huacho en el mapa" loading="lazy" decoding="async">
        </picture>
        <div>
          <a class="btn btn-primary btn-lg" href="<%= cabin.contact.mapsUrl %>" target="_blank" rel="noopener noreferrer">
            🗺️ Cómo llegar en Google Maps
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Features Highlight -->
<section class="py-5">
  <div class="container">
    <div class="row">
      <div class="col-12 text-center mb-5">
        <h2 class="display-6 fw-bold">✨ Comodidades Destacadas</h2>
        <p class="lead">Todo lo que necesitas para una estadía perfecta</p>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-md-4">
        <div class="feature-card text-center p-4 h-100">
          <div class="feature-icon mb-3" aria-hidden="true">📶</div>
          <h5 class="fw-bold">Wi-Fi Gratuito</h5>
          <p class="text-muted">Conexión estable para mantenerte comunicado</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="feature-card text-center p-4 h-100">
          <div class="feature-icon mb-3" aria-hidden="true">🚗</div>
          <h5 class="fw-bold">Estacionamiento</h5>
          <p class="text-muted">Espacio privado y seguro dentro del recinto</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="feature-card text-center p-4 h-100">
          <div class="feature-icon mb-3" aria-hidden="true">🔥</div>
          <h5 class="fw-bold">Parrilla</h5>
          <p class="text-muted">Disfruta de asados al aire libre con vista al bosque</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Activities Section -->
<section class="py-5 bg-light">
  <div class="container">
    <div class="row">
      <div class="col-12 text-center mb-5">
        <h2 class="display-6 fw-bold">🎯 Actividades y Experiencias</h2>
        <p class="lead">Descubre todo lo que puedes hacer en Pino Huacho</p>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-md-6 col-lg-3">
        <div class="activity-card text-center p-4 h-100">
          <span aria-hidden="true">🥾</span>
          <h5 class="mt-3 fw-bold">Senderismo</h5>
          <p class="text-muted">Rutas de diferentes niveles por bosques nativos</p>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="activity-card text-center p-4 h-100">
          <span aria-hidden="true">📸</span>
          <h5 class="mt-3 fw-bold">Fotografía</h5>
          <p class="text-muted">Paisajes únicos ideales para capturar momentos</p>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="activity-card text-center p-4 h-100">
          <span aria-hidden="true">🎣</span>
          <h5 class="mt-3 fw-bold">Pesca</h5>
          <p class="text-muted">Lagos y ríos cercanos para la pesca deportiva</p>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="activity-card text-center p-4 h-100">
          <span aria-hidden="true">🍃</span>
          <h5 class="mt-3 fw-bold">Observación</h5>
          <p class="text-muted">Flora y fauna nativa de la Araucanía</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-5 bg-primary text-white">
  <div class="container text-center">
    <div class="row">
      <div class="col-lg-8 mx-auto">
        <h2 class="display-5 fw-bold mb-4">🌟 ¿Listo para una Experiencia Única?</h2>
        <p class="lead mb-4">Solicita tu reserva ahora y asegura tu estadía en este paraíso natural. Disponibilidad limitada durante temporada alta.</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
          <a class="btn btn-warning btn-lg" href="/reservar">📅 Hacer Reserva</a>
          <a class="btn btn-outline-light btn-lg" href="/caracteristicas">📋 Ver Detalles</a>
        </div>
      </div>
    </div>
  </div>
</section>
