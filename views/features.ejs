<% extraScripts='<script src="/js/features.js"></script>' %>

  <section class="py-5 mt-5">
    <div class="container">
      <div class="row">
        <div class="col-12 text-center mb-4">
          <h1 class="display-4 fw-bold">🏠 Características de la Cabaña</h1>
          <p class="lead">Descubre todo lo que <%= cabin.name %> ofrece en el corazón de la Araucanía</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-4">
    <div class="container">
      <div class="row g-4">
        <% features.forEach(function(feature) { %>
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm feature-card">
              <div class="card-body text-center p-4">
                <div class="feature-icon mb-4" aria-hidden="true">
                  <% if (feature.icon==='home' ) { %>🏠
                    <% } else if (feature.icon==='wifi' ) { %>📶
                      <% } else if (feature.icon==='car' ) { %>🚗
                        <% } else if (feature.icon==='flame' ) { %>🔥
                          <% } else if (feature.icon==='utensils' ) { %>🍽️
                            <% } else if (feature.icon==='tree-pine' ) { %>🌲
                              <% } else { %>✨<% } %>
                </div>
                <h5 class="card-title fw-bold">
                  <%= feature.title %>
                </h5>
                <p class="card-text">
                  <%= feature.description %>
                </p>
              </div>
            </div>
          </div>
          <% }); %>
      </div>
    </div>
  </section>

  <!-- Detailed Amenities Section -->
  <section class="py-5 bg-light">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-6">
          <h2 class="display-6 fw-bold mb-4">✨ Comodidades Completas</h2>
          <div class="amenities-list">
            <div class="amenity-item d-flex align-items-center mb-3">
              ✅ <span class="ms-3">Ropa de cama incluida</span>
            </div>
            <div class="amenity-item d-flex align-items-center mb-3">
              ✅ <span class="ms-3">TV</span>
            </div>
            <div class="amenity-item d-flex align-items-center mb-3">
              ✅ <span class="ms-3">Parrilla para asados al aire libre</span>
            </div>
            <div class="amenity-item d-flex align-items-center mb-3">
              ✅ <span class="ms-3">Utensilios de cocina completos</span>
            </div>
            <div class="amenity-item d-flex align-items-center mb-3">
              ✅ <span class="ms-3">Terraza con vista panorámica</span>
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="cabin-specs p-4 rounded-3 shadow-sm">
            <h4 class="fw-bold mb-4">📋 Especificaciones Técnicas</h4>

            <div class="spec-row d-flex justify-content-between py-3 border-bottom">
              <strong>👥 Capacidad máxima:</strong>
              <span>
                <%= cabin.maxGuests %> personas
              </span>
            </div>

            <div class="spec-row d-flex justify-content-between py-3 border-bottom">
              <strong>🛏️ Habitaciones:</strong>
              <span>
                <%= cabin.bedroomsDetail %>
              </span>
            </div>

            <div class="spec-row d-flex justify-content-between py-3 border-bottom">
              <strong>🚿 Baños:</strong>
              <span>
                <%= cabin.bathrooms %>
              </span>
            </div>

            <div class="spec-row d-flex justify-content-between py-3 border-bottom">
              <strong>📐 Superficie:</strong>
              <span>
                <%= cabin.areaSqm %> m²
              </span>
            </div>

            <div class="spec-row d-flex justify-content-between py-3 border-bottom">
              <strong>🕐 Check-in:</strong>
              <span>a partir de las <%= cabin.checkInTime %></span>
            </div>

            <div class="spec-row d-flex justify-content-between py-3">
              <strong>🕐 Check-out:</strong>
              <span>hasta las <%= cabin.checkOutTime %></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Real Photo Gallery Section with Lightbox -->
  <section class="py-5">
    <div class="container">
      <div class="row">
        <div class="col-12 text-center mb-5">
          <h2 class="display-6 fw-bold">📸 Galería de Fotos Reales</h2>
          <p class="lead">Haz clic en cualquier fotografía para ampliarla</p>
        </div>
      </div>

      <div class="row g-4">
        <% gallery.forEach(function(photo) { %>
          <div class="col-md-6 col-lg-4">
            <button type="button"
              class="gallery-item gallery-trigger w-100 p-0 border-0 text-start position-relative overflow-hidden rounded-3"
              data-lightbox-src="<%= photo.src %>" data-lightbox-fallback="<%= photo.fallback %>"
              data-lightbox-title="<%= photo.title %>" data-lightbox-desc="<%= photo.description %>"
              aria-label="Ampliar foto: <%= photo.title %>">
              <picture>
                <source srcset="<%= photo.src %>" type="image/webp">
                <img class="img-fluid gallery-img" src="<%= photo.fallback %>" alt="<%= photo.alt %>" width="1200" height="800" loading="lazy"
                  decoding="async">
              </picture>
              <div class="gallery-overlay">
                <h5>
                  <%= photo.title %>
                </h5>
                <p class="mb-0">
                  <%= photo.description %>
                </p>
              </div>
            </button>
          </div>
          <% }); %>
      </div>
    </div>
  </section>

  <!-- Native Lightbox Dialog -->
  <dialog id="gallery-lightbox" class="gallery-lightbox" closedby="any" aria-labelledby="lightbox-title">
    <div class="lightbox-content">
      <div class="lightbox-header d-flex justify-content-between align-items-center mb-2">
        <h5 id="lightbox-title" class="mb-0 text-white"></h5>
        <button type="button" class="btn btn-sm btn-light" id="lightbox-close" aria-label="Cerrar imagen">✕
          Cerrar</button>
      </div>
      <img id="lightbox-img" src="" alt="" class="img-fluid rounded" fetchpriority="low">
      <p id="lightbox-desc" class="text-white-50 mt-2 mb-0 small"></p>
    </div>
  </dialog>

  <!-- Nearby Attractions -->
  <section class="py-5 bg-light">
    <div class="container">
      <div class="row">
        <div class="col-12 text-center mb-5">
          <h2 class="display-6 fw-bold">🏔️ Atractivos Cercanos</h2>
          <p class="lead">Descubre los lugares más visitados cerca de Lican Ray y Coñaripe</p>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4 text-center">
              <span class="fs-1" aria-hidden="true">🏞️</span>
              <h5 class="mt-3 fw-bold">Lago Calafquén</h5>
              <p class="text-muted">Uno de los lagos más visitados de la zona, ideal para deportes náuticos y playas
                familiares</p>
              <div class="small text-muted">📍 Lican Ray</div>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4 text-center">
              <span class="fs-1" aria-hidden="true">🌋</span>
              <h5 class="mt-3 fw-bold">Termas Geométricas</h5>
              <p class="text-muted">Famosas termas con arquitectura única y piscinas termales rodeadas de naturaleza</p>
              <div class="small text-muted">📍 Coñaripe</div>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4 text-center">
              <span class="fs-1" aria-hidden="true">🌲</span>
              <h5 class="mt-3 fw-bold">Parque Nacional Villarrica</h5>
              <p class="text-muted">Senderos, volcanes y bosques nativos. Uno de los parques más visitados del sur de
                Chile</p>
              <div class="small text-muted">📍 Cercano a Coñaripe y Lican Ray</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Policies Section -->
  <section class="py-5">
    <div class="container">
      <div class="row">
        <div class="col-lg-8 mx-auto text-center">
          <h2 class="display-6 fw-bold mb-4">Condiciones de Estadía</h2>

          <div class="pricing-info p-4 rounded mb-4">
            <div class="row g-3 text-start">
              <div class="col-md-6">
                <h6 class="fw-bold">✅ Incluido:</h6>
                <ul class="list-unstyled small mb-0">
                  <li>• Ropa de cama</li>
                  <li>• Wi-Fi gratuito</li>
                  <li>• Estacionamiento privado</li>
                  <li>• Uso de parrilla</li>
                  <li>• Calefacción a leña</li>
                </ul>
              </div>

              <div class="col-md-6">
                <h6 class="fw-bold">ℹ️ Políticas:</h6>
                <ul class="list-unstyled small mb-0">
                  <li>• Check-in: <%= cabin.checkInTime %>
                  </li>
                  <li>• Check-out: <%= cabin.checkOutTime %>
                  </li>
                  <li>• No se permiten mascotas</li>
                  <li>• No fumar en interiores</li>
                  <li>• Máximo <%= cabin.maxGuests %> personas</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-5 bg-primary text-white">
    <div class="container text-center">
      <h2 class="display-6 fw-bold mb-4">🌟 ¿Te Gusta lo que Ves?</h2>
      <p class="lead mb-4">Solicita tu reserva ahora y vive una experiencia inolvidable en nuestra cabaña</p>
      <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a class="btn btn-warning btn-lg" href="/reservar">📅 Reservar Ahora</a>
        <a class="btn btn-outline-light btn-lg" href="/">🏠 Volver al Inicio</a>
      </div>
    </div>
  </section>