<% extraStyles = '<link rel="stylesheet" href="/css/booking.css">' %>
<% extraScripts = '<script src="/js/booking.js"></script>' %>

<section class="py-5 mt-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card shadow-lg">
          <div class="card-header text-white text-center py-4">
            <h2 class="mb-0">🏠 Reservar <%= cabin.name %></h2>
            <p class="mb-0 mt-2">Completa el formulario para enviar tu solicitud de reserva</p>
          </div>

          <div class="card-body p-4 p-md-5">
            <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
            <div class="alert alert-danger d-block">
              <strong>⚠️ Por favor corrige los siguientes errores:</strong>
              <ul class="mb-0 mt-2">
                <% errors.forEach(function(error) { %>
                <li><%= error.msg %></li>
                <% }); %>
              </ul>
            </div>
            <% } %>

            <!-- Progress Steps -->
            <div class="progress-steps mb-4">
              <div class="d-flex justify-content-between align-items-center">
                <div class="step active" data-step-indicator="1">
                  <div class="step-number">1</div>
                  <div class="step-label">Fechas</div>
                </div>
                <div class="step-line"></div>
                <div class="step" data-step-indicator="2">
                  <div class="step-number">2</div>
                  <div class="step-label">Datos</div>
                </div>
                <div class="step-line"></div>
                <div class="step" data-step-indicator="3">
                  <div class="step-number">3</div>
                  <div class="step-label">Resumen</div>
                </div>
              </div>
            </div>

            <form id="bookingForm" method="POST" action="/reservar" data-default-price="<%= cabin.defaultPrice %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <!-- Step 1: Dates -->
              <div class="booking-step active" id="step-1">
                <h4 class="mb-4">📅 Paso 1: Selecciona tus fechas</h4>

                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label class="form-label" for="checkIn">📅 Fecha de Entrada *</label>
                    <input class="form-control" type="date" id="checkIn" name="checkIn"
                      value="<%= (typeof formData !== 'undefined' && formData && formData.checkIn) ? formData.checkIn : (typeof prefilledData !== 'undefined' && prefilledData) ? prefilledData.checkIn : '' %>"
                      required
                      min="<%= typeof todayDate !== 'undefined' ? todayDate : '' %>">
                  </div>

                  <div class="col-md-6 mb-3">
                    <label class="form-label" for="checkOut">📅 Fecha de Salida *</label>
                    <input class="form-control" type="date" id="checkOut" name="checkOut"
                      value="<%= (typeof formData !== 'undefined' && formData && formData.checkOut) ? formData.checkOut : (typeof prefilledData !== 'undefined' && prefilledData) ? prefilledData.checkOut : '' %>"
                      required>
                  </div>
                </div>

                <div class="mb-3">
                  <label class="form-label" for="guests">👥 Número de Huéspedes (máx. <%= cabin.maxGuests %>) *</label>
                  <select class="form-control" id="guests" name="guests" required>
                    <option value="" <%= (typeof formData === 'undefined' || !formData || !formData.guests) ? 'selected' : '' %>>Seleccionar...</option>
                    <% for (let i = 1; i <= cabin.maxGuests; i++) { %>
                    <option value="<%= i %>" <%= (typeof formData !== 'undefined' && formData && Number(formData.guests) === i) ? 'selected' : '' %>><%= i + (i === 1 ? ' persona' : ' personas') %></option>
                    <% } %>
                  </select>
                </div>

                <!-- Availability Preview -->
                <div class="mb-4">
                  <h5>📊 Verificación de Disponibilidad</h5>
                  <div class="calendar-container">
                    <div id="calendar-preview" class="border rounded p-3 bg-light">
                      <p class="text-center text-muted mb-0">Selecciona las fechas para verificar disponibilidad y tarifas</p>
                    </div>
                  </div>
                </div>

                <div class="text-center">
                  <button class="btn btn-primary btn-lg" type="button" data-action="next-step">
                    Continuar →
                  </button>
                </div>
              </div>

              <!-- Step 2: Guest Information -->
              <div class="booking-step d-none" id="step-2">
                <h4 class="mb-4">👤 Paso 2: Información del huésped</h4>

                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label class="form-label" for="guestName">👤 Nombre Completo *</label>
                    <span id="guestName-hint" class="field-hint">Ingresa tu nombre y apellido</span>
                    <input class="form-control" type="text" id="guestName" name="guestName"
                      autocomplete="name" enterkeyhint="next" minlength="2" maxlength="150"
                      aria-describedby="guestName-hint" data-error="guestName-error"
                      value="<%= (typeof formData !== 'undefined' && formData && formData.guestName) ? formData.guestName : '' %>" required>
                    <div id="guestName-error" class="field-error-msg">
                      <span role="img" aria-label="Error">❌</span> Ingresa un nombre de al menos 2 caracteres.
                    </div>
                  </div>

                  <div class="col-md-6 mb-3">
                    <label class="form-label" for="guestEmail">✉️ Email *</label>
                    <span id="guestEmail-hint" class="field-hint">Formato: nombre@ejemplo.cl</span>
                    <input class="form-control" type="email" id="guestEmail" name="guestEmail"
                      autocomplete="email" spellcheck="false" enterkeyhint="next"
                      aria-describedby="guestEmail-hint" data-error="guestEmail-error"
                      value="<%= (typeof formData !== 'undefined' && formData && formData.guestEmail) ? formData.guestEmail : '' %>" required>
                    <div id="guestEmail-error" class="field-error-msg">
                      <span role="img" aria-label="Error">❌</span> Ingresa un correo electrónico válido (ej. tu@correo.cl).
                    </div>
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label class="form-label" for="guestPhone">📞 Teléfono / WhatsApp *</label>
                    <span id="guestPhone-hint" class="field-hint">Incluye código de país (ej. +56 9 1234 5678)</span>
                    <input class="form-control" type="tel" id="guestPhone" name="guestPhone"
                      autocomplete="tel" inputmode="tel" enterkeyhint="next"
                      pattern="\+?[\d\s\-()]{8,20}"
                      aria-describedby="guestPhone-hint" data-error="guestPhone-error"
                      value="<%= (typeof formData !== 'undefined' && formData && formData.guestPhone) ? formData.guestPhone : '' %>"
                      required placeholder="+56 9 1234 5678">
                    <div id="guestPhone-error" class="field-error-msg">
                      <span role="img" aria-label="Error">❌</span> Ingresa un número válido de 8 a 20 caracteres.
                    </div>
                  </div>
                </div>

                <div class="mb-4">
                  <label class="form-label" for="notes">📝 Notas Adicionales</label>
                  <textarea class="form-control" id="notes" name="notes" rows="3" maxlength="1000"
                    placeholder="Hora estimada de llegada, solicitudes especiales, etc."><%= (typeof formData !== 'undefined' && formData && formData.notes) ? formData.notes : '' %></textarea>
                </div>

                <div class="d-flex justify-content-between">
                  <button class="btn btn-outline-primary" type="button" data-action="prev-step">← Volver</button>
                  <button class="btn btn-primary btn-lg" type="button" data-action="next-step">Continuar →</button>
                </div>
              </div>

              <!-- Step 3: Confirmation -->
              <div class="booking-step d-none" id="step-3">
                <h4 class="mb-4">✅ Paso 3: Revisa y envía tu solicitud</h4>

                <div class="pricing-info p-4 rounded mb-4">
                  <h5 class="fw-bold mb-3">💰 Resumen de tu solicitud</h5>

                  <div class="reservation-summary">
                    <div class="d-flex justify-content-between mb-2">
                      <span>👤 Huésped:</span>
                      <strong id="summary-name">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                      <span>✉️ Email:</span>
                      <strong id="summary-email">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                      <span>📞 Teléfono:</span>
                      <strong id="summary-phone">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                      <span>📅 Entrada:</span>
                      <strong id="summary-checkin">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                      <span>📅 Salida:</span>
                      <strong id="summary-checkout">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                      <span>👥 Huéspedes:</span>
                      <strong id="summary-guests">-</strong>
                    </div>
                    <%
                      const pData = (typeof prefilledData !== 'undefined' && prefilledData)
                        ? prefilledData
                        : { nights: 0, pricePerNight: cabin.defaultPrice, totalPrice: 0 };
                    %>
                    <div class="d-flex justify-content-between mb-2">
                      <span>🌙 Noches:</span>
                      <strong id="summary-nights"><%= pData.nights || '-' %></strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                      <span>Tarifa promedio por noche:</span>
                      <strong id="summary-price-per-night">
                        <%= new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(pData.pricePerNight) %> CLP
                      </strong>
                    </div>

                    <div id="summary-breakdown" class="small text-muted mt-2 mb-2"></div>

                    <hr>

                    <div class="d-flex justify-content-between fs-5">
                      <strong>💰 Total Estimado:</strong>
                      <strong id="summary-total">
                        <%= new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(pData.totalPrice) %> CLP
                      </strong>
                    </div>
                  </div>
                </div>

                <div class="alert alert-info d-block small mb-4">
                  ℹ️ Tu solicitud quedará registrada en estado <strong>Pendiente de Confirmación</strong> y bloquearemos temporalmente tus fechas mientras coordinamos el abono.
                </div>

                <div class="d-flex justify-content-between">
                  <button class="btn btn-outline-primary" type="button" data-action="prev-step">← Volver</button>
                  <button class="btn btn-success btn-lg" type="submit" id="submitBookingBtn">✅ Enviar Solicitud de Reserva</button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Info Section -->
<section class="py-5 bg-light">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 mx-auto text-center">
        <h3 class="fw-bold mb-4">🎯 Proceso Simple en 3 Pasos</h3>
        <div class="row g-4">
          <div class="col-md-4">
            <div class="step-card p-4 h-100">
              <div class="step-number d-inline-flex align-items-center justify-content-center mb-3">1</div>
              <h5>📅 Selecciona Fechas</h5>
              <p class="mb-0">Elige tus fechas de entrada y salida, y el número de huéspedes</p>
            </div>
          </div>

          <div class="col-md-4">
            <div class="step-card p-4 h-100">
              <div class="step-number d-inline-flex align-items-center justify-content-center mb-3">2</div>
              <h5>👤 Completa Datos</h5>
              <p class="mb-0">Ingresa tu información de contacto y comentarios especiales</p>
            </div>
          </div>

          <div class="col-md-4">
            <div class="step-card p-4 h-100">
              <div class="step-number d-inline-flex align-items-center justify-content-center mb-3">3</div>
              <h5>✅ Recibe tu Código</h5>
              <p class="mb-0">Recibes tu código de solicitud y coordinamos la confirmación</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
