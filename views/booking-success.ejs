<section class="py-5 mt-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8 text-center">
        <div class="card shadow-lg">
          <div class="card-body p-4 p-md-5">
            <div class="success-icon mb-3" aria-hidden="true">📩</div>

            <span class="badge bg-warning text-dark fs-6 px-3 py-2 mb-3">Pendiente de Confirmación</span>
            <h1 class="display-6 fw-bold text-primary mb-3">¡Solicitud de Reserva Recibida!</h1>

            <p class="lead mb-3">
              Hemos registrado tu solicitud y bloqueado temporalmente tus fechas.
              <% if (typeof emailSent !== 'undefined' && emailSent) { %>
                Te enviamos un correo con el respaldo de tu solicitud.
              <% } else { %>
                Guarda tu código de reserva para consultar el estado en cualquier momento.
              <% } %>
            </p>

            <% if (reservation.bookingCode) { %>
            <div class="alert alert-success d-inline-block px-4 py-3 mb-4">
              <div class="small text-uppercase fw-semibold">Tu Código de Reserva</div>
              <div class="fs-3 fw-bold letter-spacing-1"><%= reservation.bookingCode %></div>
            </div>
            <% } %>

            <div class="reservation-details bg-light p-4 rounded mb-4 text-start">
              <h4 class="fw-bold mb-3 text-center">📋 Detalles de tu Solicitud</h4>

              <div class="row g-3">
                <div class="col-md-6">
                  <div class="detail-item">
                    <strong>👤 Huésped:</strong>
                    <p class="mb-0"><%= reservation.guestName %></p>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="detail-item">
                    <strong>✉️ Email:</strong>
                    <p class="mb-0"><%= reservation.guestEmail %></p>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="detail-item">
                    <strong>📞 Teléfono:</strong>
                    <p class="mb-0"><%= reservation.guestPhone %></p>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="detail-item">
                    <strong>👥 Huéspedes:</strong>
                    <p class="mb-0"><%= reservation.guests + (reservation.guests === 1 ? ' persona' : ' personas') %></p>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="detail-item">
                    <strong>📅 Check-in:</strong>
                    <p class="mb-0"><%= reservation.checkIn %> (desde las <%= cabin.checkInTime %>)</p>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="detail-item">
                    <strong>📅 Check-out:</strong>
                    <p class="mb-0"><%= reservation.checkOut %> (hasta las <%= cabin.checkOutTime %>)</p>
                  </div>
                </div>
              </div>

              <hr class="my-3">

              <div class="text-center">
                <h5 class="fw-bold mb-1">💰 Total Estimado: <%= reservation.totalPrice %> CLP</h5>
                <small class="text-muted">Monto pendiente de coordinación y confirmación con el administrador</small>
              </div>
            </div>

            <div class="d-flex justify-content-center gap-3 flex-wrap mb-3">
              <a
                class="btn btn-success btn-lg"
                href="<%= cabin.contact.whatsappUrl %><%= encodeURIComponent(' Mi código de reserva es ' + (reservation.bookingCode || '')) %>"
                target="_blank"
                rel="noopener noreferrer"
              >
                💬 Coordinar por WhatsApp
              </a>
              <a class="btn btn-primary btn-lg" href="/consultar-reserva?code=<%= encodeURIComponent(reservation.bookingCode || '') %>">
                🔍 Consultar Estado
              </a>
              <a class="btn btn-outline-primary btn-lg" href="/">🏠 Volver al Inicio</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-5 bg-light">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8 text-center">
        <h3 class="fw-bold mb-4">ℹ️ Información Importante</h3>

        <div class="row g-4">
          <div class="col-md-6">
            <div class="info-card p-4 border rounded bg-white h-100">
              <div class="fs-2" aria-hidden="true">🕐</div>
              <h5 class="mt-2 fw-bold">Horarios</h5>
              <p class="mb-1"><strong>Check-in:</strong> <%= cabin.checkInTime %></p>
              <p class="mb-0"><strong>Check-out:</strong> <%= cabin.checkOutTime %></p>
            </div>
          </div>

          <div class="col-md-6">
            <div class="info-card p-4 border rounded bg-white h-100">
              <div class="fs-2" aria-hidden="true">📞</div>
              <h5 class="mt-2 fw-bold">Contacto Directo</h5>
              <p class="mb-1"><strong>Teléfono:</strong> <%= cabin.contact.phone %></p>
              <p class="mb-0"><strong>Email:</strong> <%= cabin.contact.email %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
