<div class="container-fluid px-0" data-admin-page="prices">
  <h1 class="display-6 fw-bold mb-4">Gestión de Precios</h1>

  <div class="row">
    <div class="col-md-6 mb-4">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white py-3">
          <h6 class="m-0 fw-bold">Actualizar Precios por Categoría (próximos 6 meses)</h6>
        </div>
        <div class="card-body">
          <form id="updateCategoryForm" action="/admin/precios/update-category" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <label class="form-label" for="category">Categoría de Precio</label>
              <select class="form-select" id="category" name="category" required>
                <option value="normal">Normal (Dom–Jue)</option>
                <option value="weekend">Fin de Semana (Vie–Sáb)</option>
                <option value="high_season">Temporada Alta</option>
                <option value="holiday">Feriado</option>
                <option value="special">Especial</option>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label" for="categoryPrice">Precio (CLP)</label>
              <div class="input-group">
                <span class="input-group-text">$</span>
                <input class="form-control" id="categoryPrice" type="number" name="price" min="1000" step="1000" required>
              </div>
            </div>

            <button class="btn btn-primary w-100" type="submit">Actualizar Precios por Categoría</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-md-6 mb-4">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white py-3">
          <h6 class="m-0 fw-bold">Actualizar Precios por Rango de Fechas</h6>
        </div>
        <div class="card-body">
          <form id="updateRangeForm" action="/admin/precios/update-range" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label" for="startDate">Fecha Inicio</label>
                <input class="form-control" id="startDate" type="date" name="startDate" min="<%= todayDate %>" required>
              </div>

              <div class="col-md-6 mb-3">
                <label class="form-label" for="endDate">Fecha Fin</label>
                <input class="form-control" id="endDate" type="date" name="endDate" min="<%= todayDate %>" required>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label" for="rangePrice">Precio (CLP)</label>
              <div class="input-group">
                <span class="input-group-text">$</span>
                <input class="form-control" id="rangePrice" type="number" name="price" min="1000" step="1000" required>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label" for="rangeCategory">Categoría (opcional)</label>
              <select class="form-select" id="rangeCategory" name="category">
                <option value="">Sin cambiar categoría</option>
                <option value="normal">Normal</option>
                <option value="weekend">Fin de Semana</option>
                <option value="high_season">Temporada Alta</option>
                <option value="holiday">Feriado</option>
                <option value="special">Especial</option>
              </select>
            </div>

            <button class="btn btn-primary w-100" type="submit">Actualizar Precios por Rango</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12 mb-4">
      <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
          <h6 class="m-0 fw-bold">Tarifario Próximos 3 Meses (<%= availabilityData.length %> días)</h6>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Día</th>
                  <th>Categoría</th>
                  <th>Precio</th>
                  <th>Estado</th>
                  <th class="no-sort">Acciones</th>
                </tr>
              </thead>
              <tbody id="pricePreviewTable">
                <% availabilityData.forEach(function(day) { %>
                <tr class="<%= day.status === 'occupied' ? 'table-danger' : day.status === 'maintenance' ? 'table-warning' : '' %>">
                  <td><%= day.formattedDate %></td>
                  <td><%= day.dayOfWeek %></td>
                  <td><%= day.categoryLabel %></td>
                  <td class="fw-bold"><%= day.formattedPrice %></td>
                  <td>
                    <span class="badge <%= day.status === 'available' ? 'bg-success' : day.status === 'occupied' ? 'bg-danger' : 'bg-warning text-dark' %>">
                      <%= day.statusLabel %>
                    </span>
                  </td>
                  <td>
                    <button
                      type="button"
                      class="btn btn-sm btn-outline-primary edit-price-btn"
                      data-id="<%= day.id %>"
                      data-date="<%= day.formattedDate %>"
                      data-price="<%= day.price %>"
                      data-category="<%= day.priceCategory %>"
                    >
                      Editar
                    </button>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit Price Modal -->
  <div id="editPriceModal" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Editar Precio del Día</h5>
          <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <form id="editSinglePriceForm" action="/admin/precios/update-single" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="dayId" id="editDayId">
            <div class="mb-3">
              <label class="form-label" for="editDate">Fecha</label>
              <input class="form-control" id="editDate" type="text" readonly>
            </div>

            <div class="mb-3">
              <label class="form-label" for="editPrice">Precio (CLP)</label>
              <div class="input-group">
                <span class="input-group-text">$</span>
                <input class="form-control" id="editPrice" type="number" name="price" min="1000" step="1000" required>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label" for="editCategory">Categoría</label>
              <select class="form-select" id="editCategory" name="category">
                <option value="normal">Normal</option>
                <option value="weekend">Fin de Semana</option>
                <option value="high_season">Temporada Alta</option>
                <option value="holiday">Feriado</option>
                <option value="special">Especial</option>
              </select>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancelar</button>
          <button class="btn btn-primary" type="submit" form="editSinglePriceForm">Guardar Cambios</button>
        </div>
      </div>
    </div>
  </div>
</div>
