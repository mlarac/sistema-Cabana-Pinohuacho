<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4" data-admin-page="calendar">
  <h1 class="display-6 fw-bold mb-0">Calendario de Disponibilidad</h1>
  <div class="d-flex gap-2 flex-wrap">
    <button type="button" class="btn btn-primary" id="openSingleAvailBtn">
      <i class="fas fa-edit me-1"></i> Actualizar Día
    </button>
    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#availabilityRangeModal">
      <i class="fas fa-calendar-week me-1"></i> Actualizar Rango
    </button>
    <select class="form-select" id="monthSelector" style="width: auto;" aria-label="Seleccionar mes">
      <% monthOptions.forEach(function(opt) { %>
        <option value="<%= opt.value %>" <%= opt.value === currentMonth ? 'selected' : '' %>><%= opt.label %></option>
      <% }); %>
    </select>
  </div>
</div>

<!-- Legend -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body py-3">
    <div class="d-flex flex-wrap gap-4 align-items-center">
      <div class="d-flex align-items-center">
        <div class="calendar-legend bg-success me-2"></div>
        <span>Disponible</span>
      </div>
      <div class="d-flex align-items-center">
        <div class="calendar-legend bg-danger me-2"></div>
        <span>Ocupado</span>
      </div>
      <div class="d-flex align-items-center">
        <div class="calendar-legend bg-warning me-2"></div>
        <span>Mantenimiento</span>
      </div>
      <div class="d-flex align-items-center">
        <div class="calendar-legend border border-2 border-primary me-2"></div>
        <span>Seleccionado</span>
      </div>
    </div>
  </div>
</div>

<!-- Calendar Container -->
<div class="card border-0 shadow-sm">
  <div class="card-body">
    <div id="calendar-container" class="text-center" data-initial-month="<%= currentMonth %>">
      <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Cargando calendario...</span>
      </div>
    </div>
  </div>
</div>

<!-- Single Day Availability Modal -->
<div class="modal fade" id="availabilityModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Actualizar Disponibilidad del Día</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>

      <div class="modal-body">
        <form id="availabilityForm">
          <div class="mb-3">
            <label class="form-label" for="selectedDate">Fecha</label>
            <input class="form-control" type="date" id="selectedDate" name="date" required readonly>
          </div>

          <div class="mb-3">
            <label class="form-label" for="status">Estado</label>
            <select class="form-select" id="status" name="status" required>
              <option value="available">Disponible</option>
              <option value="occupied">Ocupado</option>
              <option value="maintenance">Mantenimiento</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label" for="notes">Notas (opcional)</label>
            <textarea class="form-control" id="notes" name="notes" rows="3"></textarea>
          </div>
        </form>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-primary" type="submit" form="availabilityForm">Guardar</button>
      </div>
    </div>
  </div>
</div>

<!-- Date Range Availability Modal -->
<div class="modal fade" id="availabilityRangeModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Actualizar Disponibilidad por Rango</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>

      <div class="modal-body">
        <form id="availabilityRangeForm">
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label" for="rangeStartDate">Desde *</label>
              <input class="form-control" type="date" id="rangeStartDate" name="startDate" min="<%= todayDate %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="rangeEndDate">Hasta *</label>
              <input class="form-control" type="date" id="rangeEndDate" name="endDate" min="<%= todayDate %>" required>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="rangeStatus">Estado *</label>
            <select class="form-select" id="rangeStatus" name="status" required>
              <option value="maintenance">Mantenimiento</option>
              <option value="occupied">Ocupado (Bloqueo manual)</option>
              <option value="available">Disponible</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label" for="rangeNotes">Notas (opcional)</label>
            <textarea class="form-control" id="rangeNotes" name="notes" rows="2" placeholder="Ej: Mantención de calefacción"></textarea>
          </div>
        </form>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-primary" type="submit" form="availabilityRangeForm">Aplicar al Rango</button>
      </div>
    </div>
  </div>
</div>
