{
  "name": "pino-huacho-cabin",
  "version": "2.0.0",
  "description": "Cabin booking website for Pino Huacho, Araucanía",
  "main": "app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node --test tests/*.test.js",
    "db:update": "node config/updateDatabase.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:dates": "node config/migrateLegacyDates.js",
    "db:seed": "npx sequelize-cli db:seed:all",
    "images:optimize": "node config/optimizeImages.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "dayjs": "^1.11.13",
    "dotenv": "^16.3.1",
    "ejs": "^6.0.1",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.8",
    "sequelize": "^6.35.2",
    "sqlite3": "^5.1.6",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.2",
    "sharp": "^0.33.5",
    "supertest": "^7.0.0"
  }
}
